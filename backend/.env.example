# --- База данных ---
DATABASE_URL=postgres://vinted:vinted@localhost:5432/vinted

# --- HTTP сервер бэкенда ---
PORT=4000
# Разрешить регистрацию новых пользователей через форму (true/false)
REGISTRATION_ENABLED=true
# Максимум пользователей (регистрация закрывается, когда лимит достигнут)
MAX_USERS=5
# Срок жизни сессии логина, дней
SESSION_TTL_DAYS=30

# --- Прокси Webshare (см. src/proxy/config.ts) ---
# Сюда положи свой ключ из https://dashboard.webshare.io/userapi/keys
WEBSHARE_API_KEY=
# list     — скачать список прокси через API и крутить их по кругу (по умолчанию)
# rotating — один эндпоинт p.webshare.io:80, Webshare сам меняет IP
# off      — ходить на Vinted напрямую без прокси
PROXY_MODE=list
# Фильтр по странам прокси (через запятую, пусто = любые), напр. FR,DE,PL
PROXY_COUNTRIES=
# Как часто обновлять список прокси из Webshare, минут
PROXY_REFRESH_MINUTES=60

# --- Планировщик ---
SCHEDULER_ENABLED=true
# Как часто проверять, каким поискам пора опрашиваться, секунд
SCHEDULER_TICK_SECONDS=30
# Сколько поисков опрашивать одновременно
SCHEDULER_CONCURRENCY=2
# Пауза между запросами к Vinted, мс (чтобы не ловить 429)
VINTED_REQUEST_DELAY_MS=1500
